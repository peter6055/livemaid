# App version (optional, defaults to '0.0.0')
NEXT_PUBLIC_APP_VERSION=0.1.0

# Development server allowed origins (comma-separated, optional)
# Each developer sets their own tailscale/machine origins here
# Example: ALLOWED_DEV_ORIGINS=*.mytail.ts.net,my-machine.mytail.ts.net
ALLOWED_DEV_ORIGINS=

# Required for OIDC auth / workspace mode
# AUTH_OIDC_ISSUER=https://accounts.google.com
# AUTH_OIDC_CLIENT_ID=your-client-id
# AUTH_OIDC_CLIENT_SECRET=your-client-secret

# Auto-generated if not set (session signing secret)
# AUTH_SECRET=openssl rand -base64 32

# Required for users, workspaces, memberships, and audit logs
# MONGODB_URI=mongodb://localhost:27017/livemaid

# Auto-generated if not set (IP hashing pepper for audit logs)
# AUDIT_IP_PEPPER=another-random-string
