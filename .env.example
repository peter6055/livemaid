# --- Dev settings ---
# Development server allowed origins (comma-separated, optional)
# Example: ALLOWED_DEV_ORIGINS=*.mytail.ts.net,my-machine.mytail.ts.net
ALLOWED_DEV_ORIGINS=
# Read-only demo instance. See docs/docs/deployment/demo-mode.md
DEMO_MODE=

# --- System settings ---
# Full public URL of the app, including any reverse-proxy prefix.
# Used for OIDC callbacks, server redirects, and all client links.
# The URL path is also baked into Next.js basePath at build time (Docker ARG).
# Example: BASE_URL=https://your-domain.com/livemaid
# Leave unset for local development at the root (http://localhost:3434).
BASE_URL=
# MongoDB for users, workspaces, memberships, audit logs, and per-user preferences.
# Preferences require it in every mode (standalone included). Required for workspace mode.
MONGODB_URI=mongodb://localhost:27017/livemaid

# --- Workspace settings ---
# All required for workspace mode (OIDC sign-in, workspaces, members, audit logs).
# Copy this file to .env and fill in values. Restart after changing. No Settings UI.
WORKSPACES_ENABLED=false
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
